@page "/"

<PageTitle>Job Tracker</PageTitle>

@if (_errorMessage is not null)
{
    <div class="error-banner" role="alert">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span>@_errorMessage</span>
        <button class="btn-icon" title="Dismiss" @onclick="DismissError">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>
}

@if (_user is null)
{
    <div class="login-screen">
        <div class="login-hero">
            <div class="login-badge"><i class="fa-solid fa-briefcase"></i></div>
            <h1>Job Tracker</h1>
            <p class="login-tagline">One place to track every application, interview, and offer.</p>
            <button class="btn-primary btn-lg" @onclick="SignIn">
                <i class="fa-brands fa-google"></i> Sign in with Google
            </button>
        </div>

        <div class="login-features">
            <div class="feature"><i class="fa-solid fa-bolt"></i><span>Realtime sync, everywhere you sign in</span></div>
            <div class="feature"><i class="fa-solid fa-shield-halved"></i><span>Private — locked to your account</span></div>
            <div class="feature"><i class="fa-solid fa-table-list"></i><span>Status, dates &amp; notes at a glance</span></div>
        </div>

        <div class="login-companies">
            <p>Built for tracking applications to companies like</p>
            <div class="company-icons">
                <i class="fa-brands fa-google" title="Google"></i>
                <i class="fa-brands fa-microsoft" title="Microsoft"></i>
                <i class="fa-brands fa-amazon" title="Amazon"></i>
                <i class="fa-brands fa-apple" title="Apple"></i>
                <i class="fa-brands fa-meta" title="Meta"></i>
                <i class="fa-brands fa-airbnb" title="Airbnb"></i>
                <i class="fa-brands fa-slack" title="Slack"></i>
                <i class="fa-brands fa-spotify" title="Spotify"></i>
            </div>
        </div>
    </div>
}
else
{
    <div class="topbar">
        <h1><i class="fa-solid fa-briefcase"></i> Job Tracker</h1>
        <div class="user-info">
            @if (!string.IsNullOrWhiteSpace(_user.PhotoUrl))
            {
                <img class="avatar" src="@_user.PhotoUrl" alt="" />
            }
            <span>@_user.DisplayName</span>
            <button class="btn-secondary" @onclick="SignOutUser">Sign out</button>
        </div>
    </div>

    <div class="toolbar">
        <button class="btn-primary" @onclick="StartAdd"><i class="fa-solid fa-plus"></i> Add Application</button>
    </div>

    @if (_showForm)
    {
        <div class="form-panel">
            <h3>@(_isEditing ? "Edit Application" : "New Application")</h3>
            <div class="form-grid">
                <label>Company
                    <input @bind="_draft.Company" placeholder="Acme Corp" />
                </label>
                <label>Role
                    <input @bind="_draft.Role" placeholder="Senior Software Engineer" />
                </label>
                <label>Job Link
                    <input @bind="_draft.JobLink" placeholder="https://..." />
                </label>
                <label>Status
                    <select @bind="_draft.Status">
                        @foreach (var s in ApplicationStatus.All)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </label>
                <label>Date Applied
                    <input type="date" value="@_draft.DateApplied"
                           @oninput="e => _draft.DateApplied = e.Value?.ToString() ?? string.Empty" />
                </label>
                <label class="notes-label">Notes
                    <textarea @bind="_draft.Notes" rows="3" placeholder="Referral, recruiter contact, next steps..."></textarea>
                </label>
            </div>
            <div class="form-actions">
                <button class="btn-primary" disabled="@_isSaving" @onclick="SaveDraft">
                    @(_isSaving ? "Saving..." : "Save")
                </button>
                <button class="btn-secondary" disabled="@_isSaving" @onclick="CancelForm">Cancel</button>
            </div>
        </div>
    }

    @if (_applications.Count == 0)
    {
        <p class="empty-state">No applications yet — add your first one above.</p>
    }
    else
    {
        <table class="applications-table">
            <thead>
                <tr>
                    <th>Company</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Applied</th>
                    <th>Updated</th>
                    <th>Link</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var app in _applications)
                {
                    <tr>
                        <td>
                            <span class="company-cell">
                                <i class="@CompanyIconClass(app.Company) company-icon"></i>@app.Company
                            </span>
                        </td>
                        <td>@app.Role</td>
                        <td><span class="status status-@app.Status.ToLowerInvariant()">@app.Status</span></td>
                        <td>@app.DateApplied</td>
                        <td>@app.LastUpdate</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(app.JobLink))
                            {
                                <a href="@app.JobLink" target="_blank" rel="noopener"><i class="fa-solid fa-arrow-up-right-from-square"></i></a>
                            }
                        </td>
                        <td class="row-actions">
                            <button class="btn-icon" title="Edit" disabled="@_isDeleting" @onclick="() => StartEdit(app)"><i class="fa-solid fa-pen"></i></button>
                            <button class="btn-icon" title="Delete" disabled="@_isDeleting" @onclick="() => DeleteApplication(app.Id!)"><i class="fa-solid fa-trash"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
